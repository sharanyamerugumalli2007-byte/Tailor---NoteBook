PORT=5000
NODE_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tailor_notebook
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secure_secret
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173

SHOP_NAME=Tailor Notebook
# Optional: full path to pg_dump if it is not on PATH (common on Windows)
PG_DUMP_PATH=pg_dump
